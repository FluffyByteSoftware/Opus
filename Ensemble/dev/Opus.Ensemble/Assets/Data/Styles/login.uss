/*
 * File:       Opus/Ensemble/dev/Opus.Ensemble/Assets/Data/Styles/login.uss
 * Component:  Ensemble
 * Author:     Jacob Chacko
 * The login's look.  Only the login screen carries this sheet, so its
 * .widget is the login's and never the HUD's.  The words' colour and font
 * aren't here: they're ScreenRoot's Login Text Color and Login Text Font,
 * in the Inspector.  Sizes are in the layout's reference pixels.
 */

.widget {
    overflow: hidden;
}

/* The background: black for now.  A picture goes in here later, as
   background-image, with -unity-background-scale-mode: scale-and-crop so
   it covers any shape of screen. */
.widget-login_background {
    background-color: rgb(0, 0, 0);
}

/* The logo: a placeholder box with LOGO in the middle. */
.widget-login_logo {
    align-items: center;
    justify-content: center;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.25);
    border-radius: 6px;
}

.login-logo {
    font-size: 56px;
    -unity-font-style: bold;
    letter-spacing: 8px;
}

/* The four text boxes: the name, then the box under it. */
.login-field {
    justify-content: flex-end;
}

.login-label {
    font-size: 18px;
    margin: 0 0 4px 2px;
    padding: 0;
}

.login-box {
    height: 40px;
    margin: 0;
}

.login-box .unity-base-text-field__input {
    flex-grow: 1;
    font-size: 22px;
    padding: 4px 10px;
    background-color: rgb(24, 26, 32);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
}

.login-box:focus .unity-base-text-field__input {
    border-color: rgba(255, 255, 255, 0.6);
}

/* Remember Me: the box, then the words. */
.login-remember {
    height: 100%;
    margin: 0;
    align-items: center;
}

.login-remember .unity-toggle__text {
    font-size: 18px;
    margin-left: 8px;
}

/* SUBMIT: lighter under the mouse, and it sinks a little while it's held
   down. */
.login-submit {
    flex-grow: 1;
    margin: 0;
    font-size: 22px;
    -unity-font-style: bold;
    background-color: rgb(58, 86, 140);
    border-width: 0;
    border-radius: 4px;
}

.login-submit:hover {
    background-color: rgb(72, 104, 166);
}

.login-submit:active {
    background-color: rgb(40, 62, 104);
    translate: 0 2px;
}

/* The status line under SUBMIT.  Trouble is a dark red band behind the
   words, not a colour for them: the words' colour is ScreenRoot's. */
.widget-login_status {
    align-items: center;
    padding: 6px 10px;
    border-radius: 4px;
}

.widget-login_status.login-status--trouble {
    background-color: rgba(140, 32, 32, 0.45);
}

.login-status {
    font-size: 18px;
    white-space: normal;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

/* KICK OTHER SESSION and LOG OFF, side by side, only while the account
   is already playing somewhere else. */
.login-choice {
    flex-direction: row;
    justify-content: center;
    margin-top: 8px;
}

.login-choice-button {
    height: 40px;
    margin: 0 6px;
    padding: 0 16px;
    font-size: 16px;
    -unity-font-style: bold;
    background-color: rgb(58, 86, 140);
    border-width: 0;
    border-radius: 4px;
}

.login-choice-button:hover {
    background-color: rgb(72, 104, 166);
}
