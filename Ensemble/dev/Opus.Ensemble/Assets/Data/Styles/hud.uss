/*
 * File:       Opus/Ensemble/dev/Opus.Ensemble/Assets/Data/Styles/hud.uss
 * Component:  Ensemble
 * Author:     Jacob Chacko
 * The HUD's look.  Crude on purpose for now: dark boxes with a border that
 * lights up under the mouse, so it's easy to see what catches a click and
 * what lets it through.  Sizes are in the layout's reference pixels.
 */

.widget {
    background-color: rgba(16, 18, 24, 0.75);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    padding: 8px;
    overflow: hidden;
}

.widget:hover {
    border-color: rgba(255, 255, 255, 0.6);
}

/* An unlocked widget (Jacob, 2026-10-03): its border flashes orange, red
 * and yellow until it's locked from its right-click menu (WidgetFrame).
 * After .widget:hover, so it wins under the mouse too. */
.widget.widget-flash-orange {
    border-color: rgb(255, 140, 0);
}

.widget.widget-flash-red {
    border-color: rgb(220, 30, 30);
}

.widget.widget-flash-yellow {
    border-color: rgb(255, 220, 0);
}

/* Health: the word, then the bar. */
.widget-health {
    flex-direction: row;
    align-items: center;
}

.health-label {
    color: rgb(224, 208, 208);
    font-size: 20px;
    -unity-font-style: bold;
    margin-right: 12px;
}

.health-track {
    flex-grow: 1;
    height: 60%;
    background-color: rgb(58, 20, 20);
    border-radius: 4px;
}

.health-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(192, 48, 48);
    border-radius: 4px;
}

/* Minimap: a green box with its name in the middle. */
.widget-minimap {
    background-color: rgba(40, 60, 40, 0.75);
    align-items: center;
    justify-content: center;
}

.minimap-label {
    color: rgb(192, 216, 192);
    font-size: 24px;
}

/* Chat (Jacob, 2026-10-02): the window at 50% black, the header, the
 * lines, and the field to type in on the bottom row.  What the player sends
 * is echoed in yellow, what the server says is white.  The font is
 * ScreenRoot's Chat Font slot; the sizes are the three font-size lines
 * below, in the layout's 2560 x 1440 pixels (the first 16 px "holy shit"
 * was too small on 1440p).  The lines' and the field's 24 px is where the
 * right-click menu's font size starts (ChatWidget's DefaultFont), so the
 * two change together. */
.widget-chat {
    background-color: rgba(0, 0, 0, 0.5);
    padding: 6px;
}


.chat-header {
    color: rgb(255, 255, 255);
    font-size: 28px;
    margin: 0 0 4px 0;
    padding: 0;
}

.chat-lines {
    flex-grow: 1;
}

.chat-line {
    font-size: 24px;
    white-space: normal;
    margin: 0;
    padding: 0;
}

.chat-line-mine {
    color: rgb(255, 230, 0);
}

.chat-line-server {
    color: rgb(255, 255, 255);
}

.chat-input {
    margin: 4px 0 0 0;
    font-size: 24px;
}

/* A widget's right-click menu (WidgetMenu): LOCK or UNLOCK, and chat's
 * font size.  The cover behind it is see-through and catches the click
 * that closes it. */
.widget-menu-cover {
    background-color: rgba(0, 0, 0, 0);
}

.widget-menu {
    min-width: 300px;
    background-color: rgba(16, 18, 24, 0.95);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.35);
    border-radius: 6px;
    padding: 10px;
}

.widget-menu-title {
    color: rgb(255, 255, 255);
    font-size: 24px;
    margin: 0 0 8px 0;
    padding: 0;
}

.widget-menu-button {
    font-size: 22px;
    margin: 0 0 8px 0;
}

.widget-menu-row {
    flex-direction: row;
    justify-content: space-between;
}

.widget-menu-label {
    color: rgb(255, 255, 255);
    font-size: 22px;
    margin: 0;
    padding: 0;
}

.widget-menu-slider {
    margin: 4px 0 0 0;
}
