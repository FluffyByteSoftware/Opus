/*
 * File:       Opus/Ensemble/dev/Opus.Ensemble/Assets/Data/Styles/hud.uss
 * Component:  Ensemble
 * Author:     Jacob Chacko
 * The HUD's look.  Crude on purpose for now: dark boxes with a border that
 * lights up under the mouse, so it's easy to see what catches a click and
 * what lets it through.  Sizes are in the layout's reference pixels.
 */

.widget {
    background-color: rgba(16, 18, 24, 0.75);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    padding: 8px;
    overflow: hidden;
}

.widget:hover {
    border-color: rgba(255, 255, 255, 0.6);
}

/* Health: the word, then the bar. */
.widget-health {
    flex-direction: row;
    align-items: center;
}

.health-label {
    color: rgb(224, 208, 208);
    font-size: 20px;
    -unity-font-style: bold;
    margin-right: 12px;
}

.health-track {
    flex-grow: 1;
    height: 60%;
    background-color: rgb(58, 20, 20);
    border-radius: 4px;
}

.health-fill {
    width: 100%;
    height: 100%;
    background-color: rgb(192, 48, 48);
    border-radius: 4px;
}

/* Minimap: a green box with its name in the middle. */
.widget-minimap {
    background-color: rgba(40, 60, 40, 0.75);
    align-items: center;
    justify-content: center;
}

.minimap-label {
    color: rgb(192, 216, 192);
    font-size: 24px;
}

/* Chat: the lines, then the field to type in. */
.chat-lines {
    flex-grow: 1;
}

.chat-line {
    color: rgb(232, 232, 232);
    font-size: 20px;
    white-space: normal;
}

.chat-input {
    margin: 4px 0 0 0;
    font-size: 20px;
}
