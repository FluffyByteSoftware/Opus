# File:       Opus/.gitignore
# Component:  Opus
# Author:     Jacob Chacko
#
# What never gets committed: build output, runtime data, and the caches
# each tool leaves behind.

# Compiled output
Conductor/build/
Ensemble/build/

# Content/ itself is committed, since the default schemas live there.  What
# the programs write at runtime isn't: the configs (postgres.cfg holds the
# database password), the logs, and later the saves.  Content/Assets/ is
# the purchased art, which stays out for now.
Content/Assets/
Content/cfg/
Content/logs/

# Rust, in case target/ ever lands in dev/
**/target/

# Unity caches
Ensemble/dev/**/[Ll]ibrary/
Ensemble/dev/**/[Tt]emp/
Ensemble/dev/**/[Oo]bj/
Ensemble/dev/**/[Ll]ogs/
Ensemble/dev/**/[Uu]ser[Ss]ettings/

# Godot cache
**/.godot/

# IDE and OS clutter
.idea/
.vscode/
*.swp
.DS_Store
