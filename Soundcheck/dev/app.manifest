<?xml version="1.0" encoding="utf-8"?>
<!--
File:       Opus/Soundcheck/dev/app.manifest
Component:  Soundcheck
Author:     Jacob Chacko

Windows reads this and nothing else does.  It says the program is written
for Windows 10 and up, so Windows doesn't run it in a compatibility mode.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="0.0.1.0" name="Opus.Soundcheck" />
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
