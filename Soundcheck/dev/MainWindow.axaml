<!--
File:       Opus/Soundcheck/dev/MainWindow.axaml
Component:  Soundcheck
Author:     Jacob Chacko

The one window: the game's name across the top, the version in the corner,
and whichever screen is showing under it (the login, or admin mode).  It
fits itself to what's in it when it opens, 5 % bigger, and stays that size
(MainWindow.axaml.cs).
-->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Opus.Soundcheck.MainWindow"
        Title="Forgotten Legends"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterScreen">

  <Grid x:Name="Frame" RowDefinitions="Auto,*,Auto" Margin="24">
    <TextBlock Grid.Row="0" Classes="title" Text="FORGOTTEN LEGENDS" Margin="0,8,0,16" />

    <ContentControl Grid.Row="1" x:Name="ScreenHost" />

    <TextBlock Grid.Row="2" x:Name="VersionLine" Classes="small" HorizontalAlignment="Right" Margin="0,12,0,0" />
  </Grid>

</Window>
